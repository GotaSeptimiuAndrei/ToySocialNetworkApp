<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Font?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<AnchorPane id="mainPane"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="java_projects.demo.fxml.homepage.profile.EditProfileController"
            stylesheets="@../../css/logged.css"
            prefHeight="522.0" prefWidth="600.0">
    <Button id="main_button" fx:id="buttonHome" layoutX="14.0" layoutY="80.0" mnemonicParsing="false"
            onAction="#clickHome" prefHeight="56.0" prefWidth="120.0" text="Home" textFill="#3383ff">
        <font>
            <Font name="Arial Black" size="13.0"/>
        </font>
    </Button>
    <Label layoutX="14.0" layoutY="18.0" prefHeight="42.0" prefWidth="120.0" style="-fx-text-fill: #00a0f6;"
           text="ChitChatChain">
        <font>
            <Font name="System Bold Italic" size="30.0"/>
        </font>
    </Label>
    <Button id="main_button" fx:id="buttonSearch" layoutX="14.0" layoutY="145.0" mnemonicParsing="false"
            onAction="#clickSearch" prefHeight="56.0" prefWidth="120.0" text="Search" textFill="#3383ff">
        <font>
            <Font name="Arial Black" size="13.0"/>
        </font>
    </Button>
    <Button id="main_button" fx:id="buttonLogout" layoutX="14.0" layoutY="456.0" mnemonicParsing="false"
            onAction="#clickLogout" prefHeight="56.0" prefWidth="120.0" text="Logout" textFill="#3383ff">
        <font>
            <Font name="Arial Black" size="13.0"/>
        </font>
    </Button>
    <Button id="main_button" fx:id="buttonNotification" layoutX="14.0" layoutY="210.0" mnemonicParsing="false"
            onAction="#clickNotification" prefHeight="56.0" prefWidth="120.0" text="Notifications" textFill="#3383ff">
        <font>
            <Font name="Arial Black" size="13.0"/>
        </font>
    </Button>
    <Button id="main_button" fx:id="buttonMessages" layoutX="14.0" layoutY="275.0" mnemonicParsing="false"
            onAction="#clickMessages" prefHeight="56.0" prefWidth="120.0" text="Messages" textFill="#3383ff">
        <font>
            <Font name="Arial Black" size="13.0"/>
        </font>
    </Button>
    <Button id="main_button" fx:id="buttonProfile" layoutX="14.0" layoutY="340.0" mnemonicParsing="false"
            onAction="#clickProfile" prefHeight="56.0" prefWidth="120.0" text="Profile" textFill="#3383ff">
        <font>
            <Font name="Arial Black" size="13.0"/>
        </font>
    </Button>
    <Label fx:id="firstnameLabel" layoutX="319.0" layoutY="23.0" text="Firstname">
        <font>
            <Font size="18.0"/>
        </font>
    </Label>
    <Label fx:id="lastnameLabel" layoutX="450.0" layoutY="23.0" text="Lastname">
        <font>
            <Font size="18.0"/>
        </font>
    </Label>
    <Label fx:id="usernameLabel" layoutX="321.0" layoutY="60.0" text="\@username">
        <font>
            <Font name="System Italic" size="14.0"/>
        </font>
    </Label>
    <ImageView fitHeight="212.0" fitWidth="420.0" layoutX="158.0" layoutY="14.0" pickOnBounds="true"
               preserveRatio="true" style="-fx-opacity: 0.05;">
        <Image url="@../../../pictures/profileHighlight.jpg"/>
    </ImageView>
    <ImageView fx:id="imageView" fitHeight="144.0" fitWidth="139.0" layoutX="167.0" layoutY="23.0" pickOnBounds="true"
               preserveRatio="true">
        <Image url="@../../../pictures/messages_background.jpg"/>
    </ImageView>
    <TextField fx:id="descriptionTextField" layoutX="319.0" layoutY="96.0" prefHeight="34.0" prefWidth="253.0"
               promptText="Description"/>
    <Button id="secondary_button" fx:id="changeDescriptionButton" layoutX="416.0" layoutY="132.0"
            mnemonicParsing="false" onAction="#changeDescriptionClick" text="Save Description"/>
    <Button id="secondary_button" fx:id="changePictureButton" layoutX="167.0" layoutY="160.0" mnemonicParsing="false"
            onAction="#changePictureClick" prefHeight="26.0" prefWidth="139.0" text="Change picture"/>
    <Button id="secondary_button" fx:id="cancelChangeDescriptionButton" layoutX="521.0" layoutY="132.0"
            mnemonicParsing="false" onAction="#cancelChangeDescriptionClick" text="Cancel"/>

</AnchorPane>
